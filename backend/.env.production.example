# =====================================
# FAZAJOO BACKEND - PRODUCTION TEMPLATE
# =====================================

NODE_ENV=production

HOST=0.0.0.0
PORT=6060


# =====================================
# FRONTEND / CORS
# =====================================

CORS_ORIGINS=https://YOUR_DOMAIN.ir,https://www.YOUR_DOMAIN.ir


# =====================================
# POSTGRESQL
# =====================================

DB_HOST=YOUR_PRODUCTION_DB_HOST
DB_PORT=5432
DB_NAME=fazajoo
DB_USER=YOUR_PRODUCTION_DB_USER
DB_PASSWORD=PUT_REAL_PASSWORD_ONLY_IN_PRIVATE_ENV_FILE
DB_SSL=true


# =====================================
# AUTH
# =====================================

JWT_SECRET=PUT_A_LONG_RANDOM_PRODUCTION_SECRET_HERE_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d