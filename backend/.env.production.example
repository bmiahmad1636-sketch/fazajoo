# ============================================================
# Fazajoo Backend - Production Environment Template
# Copy to backend/.env.production on the production server.
# NEVER commit real passwords, API keys or secrets.
# ============================================================

NODE_ENV=production

# Server
HOST=0.0.0.0
PORT=6060
TRUST_PROXY=1

# Frontend / CORS
# Replace with the real Fazajoo frontend origin.
CORS_ORIGINS=https://YOUR-DOMAIN.ir

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fazajoo
DB_USER=fazajoo
DB_PASSWORD=PUT_STRONG_DATABASE_PASSWORD_HERE
DB_SSL=false

# Authentication
JWT_SECRET=PUT_A_LONG_RANDOM_JWT_SECRET_HERE
JWT_EXPIRES_IN=7d

# OTP
OTP_EXPIRES_MINUTES=2
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=PUT_A_LONG_RANDOM_OTP_HASH_SECRET_HERE

# Kavenegar
KAVENEGAR_API_KEY=PUT_REAL_KAVENEGAR_API_KEY_HERE
KAVENEGAR_SENDER=
KAVENEGAR_TEMPLATE=

# Arvan Object Storage
STORAGE_ENDPOINT=PUT_ARVAN_S3_ENDPOINT_HERE
STORAGE_REGION=default
STORAGE_BUCKET=PUT_ARVAN_BUCKET_NAME_HERE
STORAGE_ACCESS_KEY=PUT_ARVAN_ACCESS_KEY_HERE
STORAGE_SECRET_KEY=PUT_ARVAN_SECRET_KEY_HERE
STORAGE_PUBLIC_BASE_URL=PUT_ARVAN_PUBLIC_BASE_URL_HERE

# S3 compatibility
STORAGE_FORCE_PATH_STYLE=false
