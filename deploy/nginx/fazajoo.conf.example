# Replace YOUR-DOMAIN.ir and api.YOUR-DOMAIN.ir before enabling.
# This is an HTTP-only bootstrap config. Enable HTTPS using Certbot after DNS is live.
# Do not use this file as a production HTTPS configuration without issuing certificates.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name YOUR-DOMAIN.ir www.YOUR-DOMAIN.ir;
    root /var/www/fazajoo/dist;
    index index.html;
    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name api.YOUR-DOMAIN.ir;
    location / {
        proxy_pass http://127.0.0.1:6060;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 75s;
    }
}
