# =====================================
# FAZAJOO BACKEND
# =====================================

NODE_ENV=development

HOST=127.0.0.1
PORT=6060


# =====================================
# FRONTEND
# =====================================

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175


# =====================================
# POSTGRESQL
# =====================================

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fazajoo
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false


# =====================================
# AUTH
# =====================================

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d